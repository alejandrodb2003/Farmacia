// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  PHARMACY_ADMIN
  SUPERADMIN
}

enum LicenseStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum ReservationStatus {
  PENDING
  FULFILLED
  CANCELLED
}

model Pharmacy {
  id          String   @id @default(uuid())
  name        String
  cuit        String   @unique
  email       String   @unique
  address     String?
  city        String?
  province    String?
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  users       User[]
  inventory   InventoryItem[]
  licenses    License[]
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String
  name        String
  role        Role     @default(PHARMACY_ADMIN)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pharmacyId  String?
  pharmacy    Pharmacy? @relation(fields: [pharmacyId], references: [id])

  conversationMembers ConversationMember[]
  messages            Message[]
}

enum ConversationType {
  DIRECT
  GROUP
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

model Conversation {
  id        String   @id @default(uuid())
  type      ConversationType @default(DIRECT)
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   ConversationMember[]
  messages  Message[]
}

model ConversationMember {
  id              String   @id @default(uuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id])
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  role            String   @default("MEMBER") // ADMIN or MEMBER
  joinedAt        DateTime @default(now())
  lastReadMessageId String?
}

model Message {
  id              String   @id @default(uuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id])
  senderId        String
  sender          User     @relation(fields: [senderId], references: [id])
  content         String   @db.Text
  status          MessageStatus @default(SENT)
  createdAt       DateTime @default(now())
}

// Global Medication Catalog (Collaborative)
model Medication {
  id              String   @id @default(uuid())
  barcode         String   @unique // GTIN / EAN
  name            String   // Commercial name
  genericName     String?  // Active principle
  laboratory      String?
  presentation    String?  // e.g., "Comp. x 30", "Jarabe 100ml"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  inventoryItems  InventoryItem[]
}

model InventoryItem {
  id              String   @id @default(uuid())
  batch           String?  // Lote
  expirationDate  DateTime // Fecha de vencimiento
  quantity        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  pharmacyId      String
  pharmacy        Pharmacy @relation(fields: [pharmacyId], references: [id])
  medicationId    String
  medication      Medication @relation(fields: [medicationId], references: [id])

  // If a pharmacy sends a customer/cadete to another pharmacy for this specific item, we can track reservations here or in a separate model
  reservations    Reservation[]
}

model License {
  id          String        @id @default(uuid())
  startDate   DateTime
  endDate     DateTime
  status      LicenseStatus @default(ACTIVE)
  mpPaymentId String?       // MercadoPago Payment ID
  afipInvoice String?       // Link to AFIP Invoice PDF or CAE
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  pharmacyId  String
  pharmacy    Pharmacy      @relation(fields: [pharmacyId], references: [id])
}

enum PickupMethod {
  CLIENTE
  CADETE
}

model Reservation {
  id              String            @id @default(uuid())
  status          ReservationStatus @default(PENDING)
  notes           String?
  pickupMethod    PickupMethod      @default(CLIENTE)
  personName      String?
  securityPin     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  requestingPharmacyId String       // Pharmacy that sends the customer
  inventoryItemId      String
  inventoryItem        InventoryItem @relation(fields: [inventoryItemId], references: [id])
}

model SystemSettings {
  id             String   @id @default(uuid())
  mpAccessToken  String?  @db.Text
  afipCuit       String?
  afipCert       String?  @db.Text
  afipKey        String?  @db.Text
  licensePrice   Float    @default(10000)
  afipPtoVta     Int      @default(1)
  updatedAt      DateTime @updatedAt
}
